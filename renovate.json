{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "crossplane": {
    "managerFilePatterns": [
      "/(^|/)example/.*\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "crossplane"
      ],
      "matchFileNames": [
        "example/**"
      ],
      "groupName": "examples"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true,
      "groupName": "GitHub Actions"
    }
  ]
}
